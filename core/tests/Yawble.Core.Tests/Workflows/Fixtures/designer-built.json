{
  "format": "yawble-workflow/1",
  "id": "designer-built",
  "name": "Designer built",
  "description": "Counts new mail and logs it.",
  "trigger": {
    "accepts": [
      "every",
      "cron",
      "once"
    ]
  },
  "settings": [
    {
      "name": "folder",
      "type": "string",
      "label": "Mail folder",
      "default": "INBOX"
    }
  ],
  "requires": [
    {
      "name": "Example Support Inbox",
      "kind": "email",
      "actions": [
        "list"
      ]
    }
  ],
  "variables": [
    {
      "name": "found",
      "type": "int",
      "scope": "run",
      "initial": 0
    },
    {
      "name": "res",
      "type": "EmailList",
      "scope": "run"
    }
  ],
  "start": "list",
  "steps": [
    {
      "id": "done",
      "type": "end"
    },
    {
      "type": "integration",
      "use": "Example Support Inbox",
      "action": "list",
      "args": {
        "folder": "{settings.folder}",
        "max": 10
      },
      "next": "any",
      "id": "list",
      "into": "res"
    },
    {
      "type": "if",
      "when": {
        "left": "{count(vars.res.messages)}",
        "op": "gt",
        "right": 0
      },
      "then": "keep",
      "else": "done",
      "id": "any"
    },
    {
      "type": "set",
      "var": "found",
      "value": "{count(vars.res.messages)}",
      "next": "say",
      "id": "keep"
    },
    {
      "type": "log",
      "text": "{vars.found} new in {settings.folder}",
      "next": "done",
      "id": "say"
    }
  ]
}
