<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>yawble-grok-auth</AssemblyName>
    <RootNamespace>Yawble.GrokAuth</RootNamespace>
    <!-- Runs INSIDE Grok sandboxes as GROK_AUTH_PROVIDER_COMMAND, so, like yawble-bridge, a small native
         binary with no .NET runtime to grant. `dotnet publish -r <rid>` produces it. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
</Project>
