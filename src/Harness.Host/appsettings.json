{
  // ------------------------------------------------------------------
  // YOU ARE IN THE RIGHT FILE ONLY IF THIS PATH ENDS src\Harness.Host\
  //
  //   The Host is started with `dotnet run --project src\Harness.Host`,
  //   so the project folder is the content root and THIS is the copy it
  //   reads. There is a second copy at src\Harness.Host\bin\Debug\
  //   net10.0\appsettings.json. It is generated, it is NOT read when the
  //   Host is started this way, and editing it does nothing —
  //   silently. Worse, an edit there makes that copy NEWER than this
  //   one, so the build's PreserveNewest rule stops replacing it and the
  //   edit sits there looking correct forever. If you have already
  //   edited the bin copy: move the change here and delete that file.
  //
  // CHANGES ARE READ ONCE, AT STARTUP. Restart the Host after editing.
  //
  // PUT YOUR OWN ROOTS IN appsettings.Production.json, NOT HERE.
  //
  //   This file is tracked in git and ships with Roots empty, because a
  //   machine's real folders name that machine's paths. ASP.NET layers
  //   appsettings.<Environment>.json over this one automatically and
  //   nothing here sets an environment, so Production is the default.
  //   That file is gitignored: your roots survive a pull, and
  //   `git status` stays clean. Everything below still applies to it.
  //
  // ------------------------------------------------------------------
  // FileBrowser — which host folders the file picker may reach.
  //
  // WITH "Roots": [] BELOW, AS SHIPPED
  //   This instance's own data folder, and nothing else, read-only.
  //   Enough to create teams in the default place. Not enough to put a
  //   team on another drive, and no folder can be created or file
  //   uploaded through the picker.
  //
  //   That implied root is COMPUTED at startup from wherever this
  //   instance's data actually lives (--DataRoot, else Instance, else
  //   the default). It is deliberately NOT written here: this file
  //   would then name a folder a differently-started instance does not
  //   use.
  //
  // TO ALLOW MORE, list them below. Being listed means READ. The three
  // flags gate writes and all default to false:
  //
  //   "allowCreate"   create folders, upload files
  //   "allowUpdate"   overwrite an existing file  (nothing uses this yet)
  //   "allowDelete"   remove a file or folder     (nothing uses this yet)
  //
  // and one more, which is not a write:
  //
  //   "allowWatch"    a folder trigger may watch a folder inside it
  //                   (see docs/ops/folder-change-triggers.md).
  //                   The instance's own data folder is never watchable.
  //
  // BEING LISTED ALSO MEANS A TEAM MAY BE PLACED THERE, and none of the
  // three flags gate that. POST /api/teams asks only whether the folder
  // is listed, so a root added with no flags at all — meant read-only —
  // still lets anyone who may create a team (any person, or a machine
  // principal whose owner still exists) put a team's directory inside
  // it. That opens the team's documents surface (upload AND delete, to
  // every person who can sign in, since every person sees every team)
  // and runs that team's agents, with permissions bypassed, in
  // workspaces underneath it. List a folder only if you are
  // content for a team to live in it.
  //
  // ADDING ROOTS DOES NOT REMOVE THE INSTANCE FOLDER. It stays reachable.
  //
  // ROOTS ARE READ ONCE, AT STARTUP. Editing this file needs a Host
  // restart before anything here takes effect.
  //
  // Paths are container paths; mount the folder into the container
  // first (see the podman run command). Example:
  //
  //   "Roots": [
  //     { "name": "Projects", "path": "/mnt/projects", "allowCreate": true },
  //     { "name": "Archive",  "path": "/mnt/archive" }
  //   ]
  //
  // WHO CAN SEE THIS: anyone who can sign in, whatever teams they hold.
  // Agents cannot — these routes refuse every machine principal. That
  // is a bound on this API and nothing more: a member runs with
  // permissions bypassed and reaches the filesystem through its own
  // shell regardless, so do not read it as a boundary around your disk.
  // ------------------------------------------------------------------
  "FileBrowser": {
    "Roots": []
  },

  // ------------------------------------------------------------------
  // INSTANCE-WIDE SETTINGS LIVE IN THE TENANT SETTINGS DIALOG.
  //
  // wip.maxRunning, workflow.spendLimit, concierge.idleTimeout,
  // quiet.window, resume.maxAutomatic, causation.depthLimit,
  // kanban.wipLimits and theme.default are rows in `tenant_settings`,
  // changed from the product without a restart and audited in the
  // tenant log. A key below is only the FALLBACK for a setting nobody
  // has changed yet; a row always wins over it.
  //
  // Why the spend limit is settable from the product is recorded in
  // the setting's own description (GET /api/tenant/settings).
  //
  // Wip:MaxRunning is deliberately absent: its built-in default is
  // max(2, CPUs in the container's cgroup), else 4. Set it here only
  // to override that fallback.
  // ------------------------------------------------------------------
"WorkflowSpendLimit": 100000000,

  "Wip": {
    "MaxRunning": 4
  }
}
